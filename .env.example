# Copy to .env and edit. .env is gitignored.

# ── Dongle connection ───────────────────────────────────────────────
LUX_DONGLE_HOST=192.168.1.100
LUX_DONGLE_PORT=8000
LUX_WRITE_INTERVAL=30
LUX_RECONNECT_DELAY=5.0

# ── Active polling (optional) ──────────────────────────────────────
# Enable for dongles that don't auto-broadcast. Sends ReadInput requests
# every 2s across all 3 register batches for near-real-time updates.
# Leave disabled (false) if your dongle broadcasts — passive mode is
# more efficient and the dongle already pushes data every ~2 seconds.
LUX_POLL_MODE=false
# LUX_POLL_INTERVAL=2.0
# LUX_DATALOG_SERIAL=
# LUX_INVERTER_SERIAL=

# ── Storage backend ─────────────────────────────────────────────────
LUX_STORAGE_TYPE=mariadb

# MariaDB (default)
LUX_MARIADB_HOST=localhost
LUX_MARIADB_PORT=3306
LUX_MARIADB_USER=luxmon
LUX_MARIADB_PASSWORD=luxmon
LUX_MARIADB_DATABASE=luxmon

# InfluxDB (optional, set LUX_STORAGE_TYPE=influxdb)
# LUX_INFLUX_URL=http://localhost:8086
# LUX_INFLUX_TOKEN=lux-mon-token
# LUX_INFLUX_ORG=luxmon
# LUX_INFLUX_BUCKET=solar
