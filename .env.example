# Copy to .env and edit. .env is gitignored.

# ── Transport selection ───────────────────────────────────────────
# Options:
#   tcp_passive  - listen to the dongle's broadcast stream (legacy default)
#   tcp_active   - send ReadInput requests via the dongle's Modbus TCP gateway
#   replay       - replay a captured binary file for testing
LUX_TRANSPORT=tcp_active

# ── Dongle connection ───────────────────────────────────────────────
LUX_DONGLE_HOST=192.168.1.100
LUX_DONGLE_PORT=8000
LUX_READ_TIMEOUT=10.0
LUX_RECONNECT_DELAY=5.0
LUX_WRITE_INTERVAL=5

# ── Active polling settings (required for tcp_active) ───────────────
# Sends ReadInput requests every 2s across all 3 register batches.
# Datalog/inverter serials can also be saved via the web Settings page.
# Environment values take precedence over the database values.
LUX_POLL_INTERVAL=2.0
LUX_DATALOG_SERIAL=YOUR_DATALOG_SERIAL
LUX_INVERTER_SERIAL=YOUR_INVERTER_SERIAL

# Inverter / BMS model driver selection (see collector/drivers/registry.py)
LUX_INVERTER_MODEL=eg4_6000xp

# Legacy option, kept for backwards compatibility:
# LUX_POLL_MODE=true maps to LUX_TRANSPORT=tcp_active
# LUX_POLL_MODE=false

# ── Replay file (required for transport=replay) ─────────────────────
# LUX_REPLAY_FILE=capture.bin

# ── Output backends (multiple can be enabled at the same time) ──────
# MariaDB is enabled by default. Set LUX_MARIADB_ENABLED=false to disable it.
LUX_MARIADB_ENABLED=true
LUX_MARIADB_HOST=localhost
LUX_MARIADB_PORT=3306
LUX_MARIADB_USER=luxmon
LUX_MARIADB_PASSWORD=***
LUX_MARIADB_DATABASE=luxmon
LUX_MARIADB_TABLE_PREFIX=lux_

# InfluxDB (SolarAssistant-compatible schema)
# For InfluxDB 1.x leave LUX_INFLUX_TOKEN empty and set LUX_INFLUX_DATABASE.
# For InfluxDB 2.x set LUX_INFLUX_TOKEN and LUX_INFLUX_BUCKET.
LUX_INFLUX_ENABLED=false
LUX_INFLUX_URL=http://localhost:8086
# LUX_INFLUX_TOKEN=***
# LUX_INFLUX_ORG=luxmon
# LUX_INFLUX_BUCKET=solar
# LUX_INFLUX_USERNAME=
# LUX_INFLUX_PASSWORD=
LUX_INFLUX_DATABASE=luxmon

# MQTT / Home Assistant auto-discovery
LUX_MQTT_ENABLED=false
LUX_MQTT_HOST=localhost
LUX_MQTT_PORT=1883
# LUX_MQTT_USERNAME=
# LUX_MQTT_PASSWORD=
LUX_MQTT_TOPIC_PREFIX=luxmon
LUX_MQTT_HA_DISCOVERY=true
LUX_MQTT_HA_PREFIX=homeassistant
LUX_MQTT_DEVICE_NAME=luxmon
LUX_MQTT_DEVICE_ID=luxmon_solar

# Display
LUX_TEMPERATURE_UNIT=celsius

# Alerts / thresholds
LUX_ALERTS_ENABLED=false
LUX_ALERTS_SOC_LOW=20
LUX_ALERTS_SOC_CRITICAL=10
LUX_ALERTS_BATTERY_TEMP_HIGH=50
LUX_ALERTS_INVERTER_TEMP_HIGH=60
LUX_ALERTS_GRID_LOST_THRESHOLD_SEC=30

# Alert notifications
LUX_ALERTS_EMAIL_ENABLED=false
LUX_ALERTS_EMAIL_SMTP_HOST=smtp.gmail.com
LUX_ALERTS_EMAIL_SMTP_PORT=587
LUX_ALERTS_EMAIL_USERNAME=your-email@gmail.com
LUX_ALERTS_EMAIL_PASSWORD=your-app-password
LUX_ALERTS_EMAIL_FROM=your-email@gmail.com
LUX_ALERTS_EMAIL_TO=alert-destination@example.com
LUX_ALERTS_EMAIL_TLS=true
LUX_ALERTS_WEBHOOK_ENABLED=false
LUX_ALERTS_WEBHOOK_URL=https://example.com/lux-mon-webhook

# Backup / restore
LUX_BACKUP_DIR=/var/backups/lux-mon
LUX_BACKUP_KEEP_DAYS=30
#LUX_BACKUP_REMOTE=/mnt/usb/lux-mon-backups
LUX_GRAFANA_PROVISIONING=/etc/grafana/provisioning
LUX_GRAFANA_DASHBOARDS=/var/lib/grafana/dashboards

# Legacy single-storage option (kept for backwards compatibility)
# LUX_STORAGE_TYPE=mariadb
