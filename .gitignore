# lux-mon Gitignore

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# Config (contains local IPs, possibly credentials)
config.yaml
config.py
.env
.credentials
backup.tar.gz
!config.example.yaml
!config.example.py
!env.example

# Data
data/
*.db
*.sqlite

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
!docker-compose.yml
!docker/docker-compose.yml
docker-compose.mac.yml
docker/docker-compose.image.yml
docker-compose.override.yaml

# Backups (contain local DB dumps and credentials)
backups/
PROJECT.md
PLAN.md
