    {
      "id": 5,
      "type": "stat",
      "title": "EG4 data feed",
      "description": "When the newest reading was written, and how fresh that is (latest SOC point, looked up over the last 30 days whatever the time picker says). EG4 publishes every ~1-2 min, sometimes 5: Fresh under 10 min, Delayed under 30 min, Stale beyond. When Delayed or Stale, every 'now' value on this page is old.",
      "datasource": {
        "type": "influxdb",
        "uid": "lux-mon-flux"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "lux-mon-flux"
          },
          "query": "from(bucket: \"luxmon\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"luxmon_register\" and r.name == \"soc\" and r._field == \"value\")\n  |> last()\n  |> group()\n  |> sort(columns: [\"_time\"])\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, \"Last reading\": int(v: r._time) / 1000000, \"Feed\": float(v: int(v: now()) - int(v: r._time)) / 1000000000.0}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 0,
          "noValue": "No data in 30 days"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last reading"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              },
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Feed"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "range",
                    "options": {
                      "from": -3600,
                      "to": 600,
                      "result": {
                        "text": "Fresh",
                        "color": "#0ca30c",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "range",
                    "options": {
                      "from": 600,
                      "to": 1800,
                      "result": {
                        "text": "Delayed",
                        "color": "#fab219",
                        "index": 1
                      }
                    }
                  },
                  {
                    "type": "range",
                    "options": {
                      "from": 1800,
                      "to": 1000000000000.0,
                      "result": {
                        "text": "Stale",
                        "color": "#d03b3b",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#0ca30c",
                      "value": null
                    },
                    {
                      "color": "#fab219",
                      "value": 600
                    },
                    {
                      "color": "#d03b3b",
                      "value": 1800
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Battery energy today",
      "description": "Energy into (Charged) and out of (Discharged) the battery since local midnight (America/Los_Angeles), from the inverter's daily counters. EG4 refreshes these counters about every 5 min; no value until the first reading of the day.",
      "datasource": {
        "type": "influxdb",
        "uid": "lux-mon-flux"
      },
      "gridPos": {
        "x": 6,
        "y": 4,
        "w": 7,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "lux-mon-flux"
          },
          "query": "import \"timezone\"\nimport \"date\"\ntz = timezone.location(name: \"America/Los_Angeles\")\nfrom(bucket: \"luxmon\")\n  |> range(start: date.truncate(t: now(), unit: 1d, location: tz))\n  |> filter(fn: (r) => r._measurement == \"luxmon_register\" and (r.name == \"charge_energy_today\" or r.name == \"discharge_energy_today\") and r._field == \"value\")\n  |> group(columns: [\"name\"])\n  |> sort(columns: [\"_time\"])\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _field: if r.name == \"charge_energy_today\" then \"Charged\" else \"Discharged\", _value: r._value}))\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> sort(columns: [\"_time\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: kWh",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true,
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      }
    },
