    {
      "id": 14,
      "type": "barchart",
      "title": "Daily battery energy: charged vs discharged",
      "description": "Per local day (America/Los_Angeles), the day's highest value of the inverter's daily charge / discharge counters (a counter, so max, not sum). Today's bar is marked '(so far)'. Days with no data have no bar (not zero); history starts 2026-05-08 (install day; imported from the EG4 portal export).",
      "datasource": {
        "type": "influxdb",
        "uid": "lux-mon-flux"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "lux-mon-flux"
          },
          "query": "import \"timezone\"\nimport \"date\"\ntz = timezone.location(name: \"America/Los_Angeles\")\nmonths = [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"]\ntoday = date.truncate(t: now(), unit: 1d, location: tz)\nfrom(bucket: \"luxmon\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"luxmon_register\" and (r.name == \"charge_energy_today\" or r.name == \"discharge_energy_today\") and r._field == \"value\")\n  |> aggregateWindow(every: 1d, fn: max, createEmpty: false, timeSrc: \"_start\", location: tz)\n  |> map(fn: (r) => {\n      d = date.truncate(t: r._time, unit: 1d, location: tz)\n      return {\n        _time: d,\n        _value: r._value,\n        series: if r.name == \"charge_energy_today\" then \"Charged\" else \"Discharged\",\n        Day: months[date.month(t: d, location: tz) - 1] + \" \" + string(v: date.monthDay(t: d, location: tz)) + (if d == today then \" (so far)\" else \"\"),\n      }\n    })\n  |> group()\n  |> pivot(rowKey: [\"_time\", \"Day\"], columnKey: [\"series\"], valueColumn: \"_value\")\n  |> sort(columns: [\"_time\"])\n  |> keep(columns: [\"Day\", \"Charged\", \"Discharged\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: kWh",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
