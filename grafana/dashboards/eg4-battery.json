            "uid": "lux-mon-flux"
          },
          "query": "from(bucket: \"luxmon\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"luxmon_register\" and r.name == \"soc\" and r._field == \"value\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: true)\n  |> map(fn: (r) => ({_time: r._time, _value: r._value, _field: \"SOC\"}))\n  |> group(columns: [\"_field\"])\n  |> sort(columns: [\"_time\"])"
        }
