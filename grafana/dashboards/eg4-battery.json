    {
      "id": 9,
      "type": "timeseries",
      "title": "State of charge over time",
      "description": "Battery SOC (mean per interval). Source: EG4 cloud; a new point only when EG4 publishes (~every 1-2 min, sometimes 5), nothing in between. A break in the line = no data for over 10 min, not zero.",
      "datasource": {
        "type": "influxdb",
        "uid": "lux-mon-flux"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
