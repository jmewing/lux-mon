  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "State of charge",
      "description": "Latest battery state of charge. The arc is green from 20 %, amber from 10 % to 20 % and red below 10 % (band edges labelled on the arc). Source: EG4 cloud; a new point only when EG4 publishes (~every 1-2 min, sometimes 5), nothing in between.",
      "datasource": {
        "type": "influxdb",
        "uid": "lux-mon-flux"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "lux-mon-flux"
          },
          "query": "from(bucket: \"luxmon\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"luxmon_register\" and r.name == \"soc\" and r._field == \"value\")\n  |> last()\n  |> group()\n  |> sort(columns: [\"_time\"])\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, \"SOC\": r._value}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 10
              },
              {
                "color": "#0ca30c",
                "value": 20
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdMarkers": true,
        "showThresholdLabels": true,
        "sizing": "auto",
        "minVizWidth": 75,
        "minVizHeight": 75
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Battery power (+ charge / − discharge)",
      "description": "Latest net battery power = charge_power − discharge_power from the same reading. Positive = charging, negative = discharging. Source: EG4 cloud; a new point only when EG4 publishes (~every 1-2 min, sometimes 5), nothing in between.",
      "datasource": {
        "type": "influxdb",
        "uid": "lux-mon-flux"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "lux-mon-flux"
          },
          "query": "from(bucket: \"luxmon\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"luxmon_register\" and (r.name == \"charge_power\" or r.name == \"discharge_power\") and r._field == \"value\")\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"name\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => exists r.charge_power and exists r.discharge_power)\n  |> sort(columns: [\"_time\"])\n  |> last(column: \"_time\")\n  |> map(fn: (r) => ({_time: r._time, \"Battery power\": r.charge_power - r.discharge_power}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      }
    },
    {
