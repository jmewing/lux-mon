          },
          "query": "from(bucket: \"luxmon\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"luxmon_register\" and (r.name == \"charge_power\" or r.name == \"discharge_power\") and r._field == \"value\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: true)\n  |> map(fn: (r) => ({_time: r._time, _value: r._value, name: r.name}))\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"name\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({_time: r._time, _value: r.charge_power - r.discharge_power, _field: \"Battery power\"}))\n  |> group(columns: [\"_field\"])\n  |> sort(columns: [\"_time\"])"
