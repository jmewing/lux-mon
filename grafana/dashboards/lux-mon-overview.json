        {
          "alias": "PV power",
          "datasource": {
            "type": "influxdb",
            "uid": "lux-mon"
          },
          "policy": "default",
          "query": "SELECT mean(\"combined\") AS \"combined\" FROM \"PV power\" WHERE $timeFilter GROUP BY time($__interval) fill(linear)",
