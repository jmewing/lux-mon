# lux-mon Docker Compose environment
# Copy this file to the repository root as .env and fill in your values.

# --- Dongle / inverter ------------------------------------------------------
LUX_DONGLE_HOST=192.168.1.100
LUX_DONGLE_PORT=8000
LUX_TRANSPORT=tcp_active
LUX_INVERTER_MODEL=eg4_6000xp
# Serial numbers are printed on the WiFi dongle and inverter labels.
# TCP active mode needs both; passive mode does not.
LUX_DATALOG_SERIAL=YOUR_DATALOG_SERIAL
LUX_INVERTER_SERIAL=YOUR_INVERTER_SERIAL
LUX_WRITE_INTERVAL=5

# --- MariaDB ----------------------------------------------------------------
LUX_MARIADB_ROOT_PASSWORD=change-me-root
LUX_MARIADB_DATABASE=luxmon
LUX_MARIADB_USER=luxmon
LUX_MARIADB_PASSWORD=change-me
# Legacy aliases kept for v1.0 image compatibility until v1.0.1 is released.
LUX_DB_HOST=mariadb
LUX_DB_USER=luxmon
LUX_DB_PASSWORD=${LUX_MARIADB_PASSWORD}
LUX_DB_NAME=luxmon
LUX_DB_PORT=3306

# --- InfluxDB v2 -------------------------------------------------------------
# Generate a long random string for LUX_INFLUX_TOKEN (used as the admin token)
LUX_INFLUX_TOKEN=change-me-32-char-minimum-token
LUX_INFLUX_USERNAME=luxmon
LUX_INFLUX_ADMIN_PASSWORD=change-me
LUX_INFLUX_ORG=luxmon
LUX_INFLUX_BUCKET=luxmon

# --- MQTT / Home Assistant ---------------------------------------------------
LUX_MQTT_ENABLED=true
LUX_MQTT_HA_DISCOVERY=true
LUX_MQTT_TOPIC_PREFIX=luxmon
LUX_MQTT_DEVICE_NAME=luxmon
LUX_MQTT_DEVICE_ID=luxmon_solar

# --- Alerts -----------------------------------------------------------------
LUX_ALERTS_ENABLED=false
LUX_ALERTS_SOC_LOW=20
LUX_ALERTS_SOC_CRITICAL=10
LUX_ALERTS_BATTERY_TEMP_HIGH=50
LUX_ALERTS_INVERTER_TEMP_HIGH=60
LUX_ALERTS_GRID_LOST_THRESHOLD_SEC=30
# Email alerts use an authenticated SMTP relay (Gmail/Outlook/SendGrid/etc.)
LUX_ALERTS_EMAIL_ENABLED=false
LUX_ALERTS_EMAIL_SMTP_HOST=smtp.gmail.com
LUX_ALERTS_EMAIL_SMTP_PORT=587
LUX_ALERTS_EMAIL_USERNAME=your-email@gmail.com
LUX_ALERTS_EMAIL_PASSWORD=your-app-password
LUX_ALERTS_EMAIL_FROM=your-email@gmail.com
LUX_ALERTS_EMAIL_TO=alert-destination@example.com
LUX_ALERTS_EMAIL_TLS=true
# Webhook alerts POST JSON to a URL of your choice
LUX_ALERTS_WEBHOOK_ENABLED=false
LUX_ALERTS_WEBHOOK_URL=https://example.com/lux-mon-webhook

# --- Grafana ----------------------------------------------------------------
LUX_GRAFANA_ADMIN_USER=admin
LUX_GRAFANA_ADMIN_PASSWORD=change-me

# --- Backup / restore -------------------------------------------------------
# Where to store nightly backups. Set LUX_BACKUP_REMOTE to copy the archive to
# another host/path after each run. Examples:
#   LUX_BACKUP_REMOTE=/mnt/usb/lux-mon-backups
#   LUX_BACKUP_REMOTE=user@nas:/backups/lux-mon
LUX_BACKUP_DIR=/var/backups/lux-mon
LUX_BACKUP_KEEP_DAYS=30
#LUX_BACKUP_REMOTE=

# Grafana paths for backup/restore (native installs only; Docker uses volumes)
LUX_GRAFANA_PROVISIONING=/etc/grafana/provisioning
LUX_GRAFANA_DASHBOARDS=/var/lib/grafana/dashboards
