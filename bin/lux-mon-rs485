#!/srv/lux-mon/venv/bin/python3
"""CLI entry point for the lux-mon RS-485 collector."""

import argparse
import logging
import sys
from pathlib import Path

# Allow running from a source checkout without being installed.
repo = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(repo))

from collector.rs485_collector import run_rs485_collector


def main():
    parser = argparse.ArgumentParser(
        prog="lux-mon-rs485",
        description="Poll RS-485 / serial devices (JK BMS, Modbus RTU, etc.) and write to lux-mon backends",
    )
    parser.add_argument("--log-level", default="INFO", help="Logging level (DEBUG/INFO/WARNING/ERROR)")
    args = parser.parse_args()

    logging.basicConfig(
        level=getattr(logging, args.log_level.upper(), logging.INFO),
        format="%(asctime)s %(levelname)s %(name)s: %(message)s",
    )

    run_rs485_collector(log_level=args.log_level.upper())


if __name__ == "__main__":
    main()
